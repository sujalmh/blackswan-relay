# BlackSwan Relay — Sepolia env (testnet only, no real ETH)
# Copy to .env and paste your values. .env is gitignored (.gitignore:25), never committed.
# cp .env.example .env

# =============================================================================
# REQUIRED for Phase 4 Gate 4 — real proof on Sepolia (docs/TODO.md:99-117)
# =============================================================================

# 1) SEPOLIA_RPC_URL — Sepolia testnet RPC (Alchemy / Infura / QuickNode)
# How to get: Alchemy dashboard.alchemy.com or infura.io -> Create App -> Network Sepolia -> copy HTTPS URL
# Test: cast block-number --rpc-url $SEPOLIA_RPC_URL
# No purchase needed — free tier.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Alternative examples (uncomment one):
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# SEPOLIA_RPC_URL=https://1rpc.io/sepolia

# 2) PRIVATE_RPC_URL — private mempool for eth_sendPrivateTransaction (AGENTS.md:22)
# How to get: keep default (free, no key) or use MEV Blocker
# Default = Flashbots Protect (works on Sepolia chain 11155111, no key)
PRIVATE_RPC_URL=https://protect.flashbots.net
# Alternative: MEV Blocker -> https://mevblocker.io -> Connect -> copy URL
# PRIVATE_RPC_URL=https://rpc.mevblocker.io/?key=YOUR_MEVBLOCKER_KEY
# To skip private mempool (fallback to public RPC, logged as deviation in BUILD_LOG.md): leave empty
# PRIVATE_RPC_URL=

# 3) DEPLOYER_PRIVATE_KEY — funded Sepolia key (0x + 0.2 SepoliaETH)
# How to get key: cast wallet new  OR  MetaMask -> Account -> Export Private Key (use fresh burner, never mainnet key)
# How to get SepoliaETH (free faucet, no crypto purchase):
#   - https://www.alchemy.com/faucets/ethereum-sepolia  (0.5/day)
#   - https://faucet.quicknode.com/ethereum/sepolia
#   - https://sepoliafaucet.com (PoW mine)
# Paste address into faucet, wait 30s, verify: cast balance --rpc-url $SEPOLIA_RPC_URL 0xYOUR_ADDRESS
# Total needed ~0.02 SepoliaETH for all deploys + 2 settle calls
DEPLOYER_PRIVATE_KEY=0xYOUR_FUNDED_SEPOLIA_PRIVATE_KEY

# =============================================================================
# OPTIONAL — only for explorer verification
# =============================================================================

# 4) ETHERSCAN_API_KEY — for forge verify-contract on Sepolia
# How to get: etherscan.io -> Sign up -> API Keys -> Create -> copy
# Leave empty if you don't want verification links
ETHERSCAN_API_KEY=

# =============================================================================
# NOTES
# =============================================================================
# - All SepoliaETH is valueless testnet faucet ETH — no real money.
# - For local-only dry run (no faucet): leave DEPLOYER_PRIVATE_KEY empty and reply `local-only` — scripts run on anvil fork.
# - Frontend (Phase 5) reads same SEPOLIA_RPC_URL / PRIVATE_RPC_URL — no extra vars needed.
